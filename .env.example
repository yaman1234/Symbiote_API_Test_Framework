# Copy to .env and fill in values. Trailing slash on BASE_URL is recommended (config normalizes).
# See README "Minimizing skipped tests" for a full-run checklist.

BASE_URL=https://api-qa.symbiotes.co.uk/api/v1/
API_TIMEOUT_MS=30000
AUTH_TYPE=none

# Core auth (required for most OTP-chain tests)
LOGIN_EMAIL=
LOGIN_PASSWORD=
VERIFY_OTP=111111

# Set to 1 only while POST /auth/send-otp is broken on QA — otherwise leave unset so OTP tests run
# SKIP_OTP_CHAIN_TESTS=

# Optional auth / matrix
RUN_PADDED_LOGIN_EMAIL_TEST=
PROTECTED_API_PATH=
TIER3_MEMBER_EMAIL=
TIER3_MEMBER_PASSWORD=

# User management
USER_MGMT_OWNER_EMAIL=
USER_MGMT_OWNER_PASSWORD=
USER_MGMT_EMPLOYEE_EMAIL=
USER_MGMT_EMPLOYEE_PASSWORD=
USER_MGMT_SUPERVISOR_EMAIL=
USER_MGMT_SUPERVISOR_PASSWORD=
USER_CREATE_BRANCH_ID=
USER_CREATE_DEPARTMENT_IDS=
USER_CREATE_WRONG_BRANCH_ID=

# Tasks module (branch UUID for task routes — optional if verify-otp returns branchId; use helpers/tasksContext.js)
TASKS_BRANCH_ID=
TASKS_OWNER_EMAIL=
TASKS_OWNER_PASSWORD=
TASKS_SUPERVISOR_EMAIL=
TASKS_SUPERVISOR_PASSWORD=
TASKS_EMPLOYEE_EMAIL=
TASKS_EMPLOYEE_PASSWORD=

# Optional password-action regression (consumes token)
PASSWORD_ACTION_TOKEN_RAW=
PASSWORD_ACTION_EXPECT_PURPOSE=
PASSWORD_ACTION_NEW_PASSWORD=

# Optional: recurrence delete smoke in tasks.delete.spec.js
RUN_TASKS_RECURRENCE_TEST=
