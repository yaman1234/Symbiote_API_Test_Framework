# Symbiote API (QA) — copy to `.env` and set secrets locally (never commit `.env`)

BASE_URL=https://api-qa.symbiotes.co.uk/api/v1/
API_TIMEOUT_MS=30000
AUTH_TYPE=none

# Login for POST /auth/login — required for auth smoke tests (pick email from tests/data/qa-seeded-accounts.md)
LOGIN_EMAIL=
# Seeded QA demo password for those accounts is Password@1 (do not commit real secrets)
LOGIN_PASSWORD=

# OTP for POST /auth/verify-otp smoke (after send-otp); QA often uses 111111
VERIFY_OTP=111111

# Set to 1 to skip tests that need POST /auth/send-otp to succeed (e.g. QA returns 500 on that route)
# SKIP_OTP_CHAIN_TESTS=1

# Set to 1 to run login smoke that sends leading/trailing whitespace + UPPERCASE email (after API trims before validation)
# RUN_PADDED_LOGIN_EMAIL_TEST=1

# QA matrix [14]: GET path relative to BASE_URL (no leading /), e.g. accounts/me — required for that regression row
# PROTECTED_API_PATH=

# QA matrix [15]: Tier 3 branch member (e.g. t3.emp1@demo.com); password defaults to LOGIN_PASSWORD if unset
# TIER3_MEMBER_EMAIL=
# TIER3_MEMBER_PASSWORD=
