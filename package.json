{
  "name": "symbiote-api-testing-framework",
  "version": "1.0.0",
  "description": "Symbiote API testing foundation using Playwright + JavaScript",
  "private": true,
  "scripts": {
    "test": "playwright test tests/api",
    "testcases:generate": "node scripts/testcase-sync/generate-master-testcases.js",
    "testcases:restructure": "node scripts/testcase-sync/restructure-master-xlsx.js",
    "testcases:sync": "node scripts/testcase-sync/sync-test-results.js",
    "testcases:refresh": "npm run testcases:generate && npm run test:api && npm run testcases:sync",
    "pw:install": "playwright install",
    "test:smoke": "playwright test --grep @smoke",
    "test:smoke:list": "playwright test --grep @smoke --list",
    "test:list": "playwright test --list",
    "test:regression": "playwright test --grep @regression",
    "test:manager-report": "playwright test --grep @regression",
    "test:negative": "playwright test --grep @negative",
    "test:negative:list": "playwright test --grep @negative --list",
    "test:users": "playwright test --grep @users",
    "test:tasks": "playwright test --grep @tasks",
    "test:module:auth": "playwright test tests/api/modules/auth",
    "test:module:tasks": "playwright test tests/api/modules/tasks",
    "test:module:users": "playwright test tests/api/modules/users",
    "test:module:auth:smoke": "playwright test tests/api/modules/auth/smoke",
    "test:module:tasks:smoke": "playwright test tests/api/modules/tasks/smoke",
    "test:module:users:smoke": "playwright test tests/api/modules/users/smoke",
    "test:module:auth:negative": "playwright test tests/api/modules/auth/negative",
    "test:module:tasks:negative": "playwright test tests/api/modules/tasks/negative",
    "test:module:users:negative": "playwright test tests/api/modules/users/negative",
    "test:smoke-and-negative": "playwright test --grep \"@smoke|@negative\"",
    "test:api": "playwright test tests/api",
    "report:open": "playwright show-report",
    "postman:build": "node scripts/postman/build-collection.js",
    "postman:routes": "node scripts/postman/print-routes.js"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1"
  },
  "dependencies": {
    "ajv": "^8.18.0",
    "dotenv": "^17.4.1",
    "exceljs": "^4.4.0",
    "xlsx": "^0.18.5"
  }
}
